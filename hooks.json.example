{
  "gemini-filter-guardrail": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/scripts/provider-filter-guardrail.py",
        "timeout": 10
      }
    ]
  },
  "gemini-filter-retry": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/scripts/provider-filter-retry.py",
        "timeout": 10
      }
    ]
  },
  "gemini-filter-notice": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/scripts/provider-filter-notice.py",
        "timeout": 5
      }
    ]
  }
}
