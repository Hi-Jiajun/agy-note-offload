{
  "name": "agy-note-offload",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "Google Antigravity Note Offload plugin workspace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hi-Jiajun/agy-note-offload"
  },
  "scripts": {
    "sync": "node ./scripts/sync-meta.mjs",
    "sync:check": "node ./scripts/sync-meta.mjs --check",
    "check:privacy": "node ./scripts/check-privacy.mjs",
    "test": "node --test ./tests/*.test.mjs",
    "test:ui": "node ./scripts/offload-ui-smoke.mjs",
    "test:eval": "node ./scripts/offload-skill-eval.mjs",
    "replay": "node ./scripts/offload-replay.mjs",
    "mine": "node ./scripts/offload-miner.mjs",
    "doctor": "node ./scripts/offload-doctor.mjs",
    "release:list": "node ./scripts/offload-release.mjs list",
    "release:snapshot": "node ./scripts/offload-release.mjs snapshot",
    "release:rollback": "node ./scripts/offload-release.mjs rollback",
    "release:install": "node ./scripts/offload-release.mjs install",
    "validate": "agy plugin validate ./plugin --strict --json",
    "build": "node ./scripts/build-release.mjs"
  }
}
