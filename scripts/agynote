#!/usr/bin/env python3
"""agynote: 双向文件工作台管理与会话健康看板（task.md 输入 <-> status.md / turn-N.md 输出）。

用法：
  agynote init <工作台名> [任务文件路径 | -]   创建 ~/agy-notes/<工作台名>/{task.md,status.md} 并打印一行启动短句
  agynote show <工作台名或前缀>                查看当前 status.md 与笔记列表
  agynote status [all]                        显示活跃工作台与会话健康看板（OK / RETRY / DEAD）
  agynote ls                                  同 status 的简要视图
  agynote clean                               安全清理 ~/agy-notes/ 下 0 文件的空目录
"""
import json
import os
import re
import sys
import time
from pathlib import Path

NOTE_ROOT = Path(os.path.expanduser(os.environ.get("AGY_NOTE_ROOT") or "~/agy-notes")).resolve()
DATA_DIR = Path(os.path.expanduser(os.environ.get("AGY_OFFLOAD_DATA_DIR") or "~/.local/share/agy-note-offload"))
STATE_PATH = DATA_DIR / ".filter-retry-state.json"
RETRY_WINDOW = 15 * 60
WS_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")


def short_path(p):
    abs_p = Path(p).resolve()
    home = Path.home().resolve()
    try:
        rel = abs_p.relative_to(home)
        return "~" if str(rel) == "." else f"~/{rel.as_posix()}"
    except ValueError:
        return str(abs_p)


def _ws_name_from_entry(cid, entry):
    nd = entry.get("note_dir") or ""
    if isinstance(nd, str):
        prefixes = (
            "~/agy-notes/",
            short_path(NOTE_ROOT).rstrip("/") + "/",
            str(NOTE_ROOT).rstrip("/") + "/",
        )
        for pfx in prefixes:
            if nd.startswith(pfx):
                rel = nd[len(pfx):].strip("/")
                if rel and "/" not in rel and ".." not in rel:
                    return rel
    return cid[:8]

TASK_TEMPLATE = """# 任务单（{name}）

## 目标
- 在此填写本阶段唯一工程目标与验收判据。

## 待办阶段
- [ ] 阶段 1：
- [ ] 阶段 2：

## 约束与参考路径
- 参考文件：
- 注意事项：脚本大输出请直接写文件，不要直接刷终端。
"""

STATUS_TEMPLATE = """# 进度看板（{name}）

- 更新时间：{now}
- 当前状态：待启动
- 最新详稿：暂无

## 阶段进展
- 尚未开始执行，请读取同目录 `task.md` 推进第一项未完成阶段。
"""


def load_state():
    if not STATE_PATH.is_file():
        return {}
    try:
        raw = json.loads(STATE_PATH.read_text(encoding="utf-8"))
        return raw if isinstance(raw, dict) else {}
    except (OSError, ValueError):
        return {}


def resolve_ws(prefix):
    if not prefix or "/" in prefix or ".." in prefix or not re.fullmatch(r"[A-Za-z0-9._-]+", prefix):
        sys.exit(f"工作台名称或前缀非法: {prefix}")
    exact = NOTE_ROOT / prefix
    if exact.is_dir():
        return exact
    matches = sorted(
        [p for p in NOTE_ROOT.glob(f"{prefix}*") if p.is_dir()],
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )
    if matches:
        return matches[0]
    sys.exit(f"未找到工作台目录: {NOTE_ROOT / prefix}")


def status_summary(ws_dir):
    sf = ws_dir / "status.md"
    if not sf.is_file():
        return "-"
    try:
        lines = sf.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return "-"
    for ln in lines:
        s = ln.strip()
        if s.startswith("- 当前状态：") or s.startswith("- 状态："):
            val = s.split("：", 1)[1].strip()
            return val if len(val) <= 44 else val[:43] + "…"
    for ln in lines:
        s = ln.strip()
        if s and not s.startswith("#") and not s.startswith("- 更新时间"):
            return s if len(s) <= 44 else s[:43] + "…"
    return "-"


def session_health(entry, now):
    if not isinstance(entry, dict):
        return "NONE"
    ts = float(entry.get("ts") or 0)
    within = (now - ts) <= RETRY_WINDOW
    tries = int(entry.get("tries") or 0)
    if entry.get("dead") and within:
        return f"DEAD({entry.get('dead_reason') or 'locked'})"
    if tries > 0 and within:
        return f"RETRY({tries})"
    if entry.get("offload_mode"):
        return "OK(offload)"
    return "OK"


def cmd_init(args):
    if not args:
        sys.exit("用法: agynote init <工作台名> [任务文件路径 | -]")
    name = args[0].strip("/")
    if not WS_RE.fullmatch(name) or ".." in name:
        sys.exit("工作台名称非法（仅支持字母、数字及 . _ -，长度 1-64）")
    ws = NOTE_ROOT / name
    ws.mkdir(parents=True, exist_ok=True)
    task_file = ws / "task.md"
    status_file = ws / "status.md"
    now = time.strftime("%F %T")

    if len(args) >= 2:
        src = args[1]
        content = sys.stdin.read() if src == "-" else Path(src).expanduser().read_text(encoding="utf-8")
        task_file.write_text(content, encoding="utf-8")
    elif not task_file.exists():
        task_file.write_text(TASK_TEMPLATE.format(name=name), encoding="utf-8")

    if not status_file.exists():
        status_file.write_text(STATUS_TEMPLATE.format(name=name, now=now), encoding="utf-8")

    short_ws = short_path(ws)
    print(f"已就绪: {short_ws}/ (task.md, status.md)")
    print("复制到聊天框直接发送：")
    print(f"/note-offload 读取 {short_ws}/task.md 与 status.md，执行下一未完成阶段并落盘汇报。")


def cmd_show(args):
    if not args:
        sys.exit("用法: agynote show <工作台名或前缀>")
    ws = resolve_ws(args[0])
    ws_disp = short_path(ws)
    print(f"=== 工作台: {ws_disp} ===")
    status_file = ws / "status.md"
    if status_file.exists():
        print(status_file.read_text(encoding="utf-8").rstrip())
    turns = sorted(ws.glob("turn-*.md"), key=lambda p: p.stat().st_mtime)
    if turns:
        print("\n=== 已落盘详稿 ===")
        for t in turns[-10:]:
            print(f"- {ws_disp}/{t.name} ({t.stat().st_size} B)")


def cmd_status(args):
    show_all = bool(args and args[0] == "all")
    now = time.time()
    state = load_state()

    # 将 state 条目按工作台名或 conv8 映射，方便聚合展示
    by_ws = {}
    unmapped = []
    for cid, entry in state.items():
        if not isinstance(entry, dict) or cid in ("probe", "selftest", "None", "unknown"):
            continue
        ws_name = _ws_name_from_entry(cid, entry)
        by_ws.setdefault(ws_name, []).append((cid, entry))

    dirs = []
    if NOTE_ROOT.is_dir():
        dirs = sorted(
            [p for p in NOTE_ROOT.iterdir() if p.is_dir()],
            key=lambda p: p.stat().st_mtime,
            reverse=True,
        )

    limit = None if show_all else 20
    print(f"{'工作台':<22} | {'文件':>4} | {'绑定会话':<10} | {'状态':<20} | {'步数':>5} | {'更新时间':<11} | 看板摘要")
    print("-" * 115)

    seen_dirs = set()
    for d in dirs[:limit]:
        seen_dirs.add(d.name)
        entries = list(d.iterdir())
        n_files = sum(1 for f in entries if f.is_file())
        mtime = time.strftime("%m-%d %H:%M", time.localtime(d.stat().st_mtime))
        binds = by_ws.get(d.name) or []
        if binds:
            cid, entry = max(binds, key=lambda x: float(x[1].get("ts") or 0))
            cid8 = cid[:8]
            health = session_health(entry, now)
            step = str(entry.get("step") if entry.get("step") is not None else "-")
        else:
            cid8 = "-"
            health = "-"
            step = "-"
        summary = status_summary(d)
        print(f"{d.name:<22} | {n_files:>4} | {cid8:<10} | {health:<20} | {step:>5} | {mtime:<11} | {summary}")

    # 补充尚无磁盘目录但已在 state 中的活跃会话
    for ws_name, binds in by_ws.items():
        if ws_name in seen_dirs:
            continue
        cid, entry = max(binds, key=lambda x: float(x[1].get("ts") or 0))
        health = session_health(entry, now)
        step = str(entry.get("step") if entry.get("step") is not None else "-")
        ts_str = time.strftime("%m-%d %H:%M", time.localtime(float(entry.get("ts") or 0))) if entry.get("ts") else "-"
        unmapped.append((ws_name, cid[:8], health, step, ts_str))

    if unmapped:
        print("\n[无落盘文件的追踪会话]")
        for ws_name, cid8, health, step, ts_str in unmapped:
            print(f"{ws_name:<22} |    0 | {cid8:<10} | {health:<20} | {step:>5} | {ts_str:<11} | -")


def cmd_clean():
    root_disp = short_path(NOTE_ROOT)
    if not NOTE_ROOT.is_dir():
        print(f"{root_disp} 不存在，无需清理")
        return
    removed = []
    kept = 0
    for d in sorted(NOTE_ROOT.iterdir()):
        if d.is_symlink() or not d.is_dir():
            continue
        try:
            has_any = any(d.iterdir())
        except OSError:
            continue
        if not has_any:
            try:
                d.rmdir()
                removed.append(d.name)
            except OSError:
                kept += 1
        else:
            kept += 1
    print(f"清理完成：删除 {len(removed)} 个空目录，保留 {kept} 个有效目录")
    if removed:
        print("已清理:", ", ".join(removed))


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    rest = sys.argv[2:]
    if cmd == "init":
        cmd_init(rest)
    elif cmd == "show":
        cmd_show(rest)
    elif cmd in ("status", "ls", "list"):
        cmd_status(rest)
    elif cmd == "clean":
        cmd_clean()
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main()
