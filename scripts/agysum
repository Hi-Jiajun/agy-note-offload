#!/usr/bin/env python3
"""把 Antigravity 的 transcript.jsonl 压成要点，接续旧会话时用它代替整份转储。

原始转储里有大量 <USER_REQUEST> 标签、结构化清单和代码串，整份倒进上下文是主要触发面；
这里只留角色、步号、压平后的前 N 字，默认 120 字、只看最后 40 步。

用法：
  agysum <transcript.jsonl> [--tail 40] [--width 120] [--full]
  agysum <会话ID>            # 自动定位到该会话的 transcript
"""
import argparse
import json
import pathlib
import sys

BRAIN = pathlib.Path.home() / ".gemini/antigravity/brain"


def positive_int(val):
    try:
        n = int(val)
    except ValueError as exc:
        raise argparse.ArgumentTypeError(f"必须为正整数: {val}") from exc
    if n < 1:
        raise argparse.ArgumentTypeError(f"必须 >= 1: {val}")
    return n


def resolve(arg):
    p = pathlib.Path(arg)
    if p.exists():
        return p
    cand = BRAIN / arg / ".system_generated/logs/transcript.jsonl"
    if cand.exists():
        return cand
    # 允许只给 ID 前缀
    for d in sorted(BRAIN.glob(arg + "*")):
        c = d / ".system_generated/logs/transcript.jsonl"
        if c.exists():
            return c
    sys.exit(f"找不到 transcript: {arg}")


def flat(text, width):
    out = " ".join((text or "").split())
    out = out.replace("<USER_REQUEST>", "").replace("</USER_REQUEST>", "")
    return out if len(out) <= width else out[:width] + "…"


def main():
    parser = argparse.ArgumentParser(
        prog="agysum",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("target", help="transcript.jsonl 路径、会话 ID 或前缀")
    parser.add_argument("--tail", type=positive_int, default=40, help="仅输出末尾 N 步（默认 40）")
    parser.add_argument("--width", type=positive_int, default=120, help="单行内容最大宽度（默认 120）")
    parser.add_argument("--full", action="store_true", help="输出全部步骤")
    args = parser.parse_args()

    path = resolve(args.target)
    rows = []
    bad_lines = 0
    with path.open(encoding="utf-8", errors="replace") as fh:
        for line in fh:
            s = line.strip()
            if not s:
                continue
            try:
                rec = json.loads(s)
            except ValueError:
                bad_lines += 1
                continue
            if not isinstance(rec, dict):
                bad_lines += 1
                continue
            rows.append(rec)

    picked = rows if args.full else rows[-args.tail:]
    blocked = sum(
        1 for r in rows
        if isinstance(r.get("content"), str) and "blocked by Gemini" in r["content"]
    )
    bad_note = f"（跳过 {bad_lines} 行损坏记录）" if bad_lines else ""
    print(f"# {path}\n# 共 {len(rows)} 步，其中被拦 {blocked} 次{bad_note}；下面取 {'全部' if args.full else f'最后 {len(picked)} 步'}")
    for r in picked:
        raw_c = r.get("content")
        c = raw_c if isinstance(raw_c, str) else ("" if raw_c is None else json.dumps(raw_c, ensure_ascii=False))
        if "blocked by Gemini" in c:
            c = "[被拦]"
        kind = str(r.get("type") or "")
        who = "U" if kind == "USER_INPUT" else ("S" if kind.startswith("SYSTEM") else "M")
        if who == "S":
            continue
        print(f"{who}{r.get('step_index')}: {flat(c, args.width)}")


if __name__ == "__main__":
    main()
